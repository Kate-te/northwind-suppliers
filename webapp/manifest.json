{
    "_version": "1.89.0",
    "sap.app": {
        "id": "sap.btp.northwindsuppliers",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "dataSources": {
            "mainService": {
                "uri": "/V3/Northwind/Northwind.svc/",
                "type": "OData",
                "settings": {
                    "annotations": ["annotation0"],
                    "localUri": "localService/metadata.xml",
                    "odataVersion": "2.0"
                }
            },
            "annotation0": {
                "uri": "annotations/annotation.xml",
                "type": "ODataAnnotation",
                "settings": {
                    "localUri": "annotations/annotation.xml"
                }
            }
        },
        "crossNavigation": {
            "inbounds": {
                "northwindsuppliers-display": {
                    "semanticObject": "northwindsuppliers",
                    "action": "display",
                    "title": "{{flpTitle}}",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.comp": {},
                "sap.ui.table": {},
                "sap.suite.ui.generic.template": {},
                "sap.ui.generic.app": {},
                "sap.f": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "defaultOperationMode": "Server",
                    "defaultBindingMode": "TwoWay",
                    "defaultCountMode": "Inline",
                    "refreshAfterChange": false
                }
            },
            "@i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/i18n.properties"
            }
        }
    },
    "sap.ui.generic.app": {
        "_version": "1.3.0",
        "settings": {
            "forceGlobalRefresh": false,
            "objectPageHeaderType": "Dynamic",
            "considerAnalyticalParameters": false,
            "showDraftToggle": false
        },
        "pages": {
            "ListReport|Supplier": {
                "entitySet": "Suppliers",
                "component": {
                    "name": "sap.suite.ui.generic.template.ListReport",
                    "list": true,
                    "settings": {
                        "annotationPath": "com.sap.vocabularies.UI.v1.LineItem",
                        "gridTable": false,
                        "multiSelect": false,
                        "smartVariantManagement": true
                    }
                },
                "pages": {
                    "ObjectPage|Supplier": {
                        "entitySet": "Suppliers",
                        "defaultLayoutTypeIfExternalNavigation": "MidColumnFullScreen",
                        "component": {
                            "name": "sap.suite.ui.generic.template.ObjectPage",
                            "settings": {
                                "showRelatedApps": false
                            }
                        },
                        "pages": {
                            "ObjectPage|Product": {
                                "entitySet": "Products",
                                "navigationProperty": "Products",
                                "defaultLayoutTypeIfExternalNavigation": "MidColumnFullScreen",
                                "component": {
                                    "name": "sap.suite.ui.generic.template.ObjectPage",
                                    "settings": {}
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "sap.cloud": {
        "public": true,
        "service": "northwindsuppliers"
    }
}
