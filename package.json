{
    "name": "northwind-suppliers",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "ui5 serve -o index.html",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
        "build:cf": "ui5 build --config=ui5-deploy.yaml --clean-dest --dest dist",
        "build:mta": "mbt build --mtar archive",
        "lint": "eslint webapp"
    },
    "devDependencies": {
        "@ui5/cli": "^4.0.0",
        "@sap/ux-ui5-tooling": "^1.14.4",
        "ui5-task-zipper": "^3.0.0",
        "mbt": "^1.2.28"
    }
}
